<WixLocalization Culture="uk-ua" Language="1058" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="Caption">Інсталяція [WixBundleName]</String>
  <String Id="Title">[WixBundleName]</String>
  <String Id="InstallVersion">Версія [WixBundleVersion]</String>
  <String Id="ConfirmCancelMessage">Справді скасувати встановлення?</String>
  <String Id="ExecuteUpgradeRelatedBundleMessage">Попередня версія</String>
  <String Id="HelpHeader">Довідка з інсталяції</String>
  <String Id="HelpText">/install | /repair | /uninstall | /layout [каталог] - встановлює, відновлює, видаляє або
   створює повну локальну копію пакета в каталозі. Типова дія: встановлення.

/passive | /quiet - відображає спрощений інтерфейс користувача без запитів або не відображає
   інтерфейс і запити взагалі. За замовчуванням відображається повний інтерфейс.

/norestart - забороняє спроби перезавантаження. За замовчуванням перед перезавантаженням з'являється запит.
/log log.txt - зберігає журнал у вказаний файл. За замовчуванням файл журналу створюється у папці %TEMP%.</String>
  <String Id="HelpCloseButton">&amp;Закрити</String>
  <String Id="InstallAcceptCheckbox">Я &amp;погоджуюся з умовами ліцензії</String>
  <String Id="InstallLaunchCheckbox">&amp;Запустити WindowCraft після встановлення</String>
  <String Id="InstallOptionsButton">&amp;Параметри</String>
  <String Id="InstallInstallButton">&amp;Встановити</String>
