  <String Id="OptionsOkButton">&amp;OK</String>
  <String Id="OptionsCancelButton">&amp;Скасувати</String>
  <String Id="ProgressHeader">Перебіг інсталяції</String>
  <String Id="ProgressLabel">Обробка:</String>
