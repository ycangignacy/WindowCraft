<?xml version="1.0" encoding="UTF-8"?>
<!-- Made by WindowCraft Dev Team -->
<!--
  Per-machine MSI. Program Files is deliberate: this tool runs elevated, so it
  must live where standard users cannot replace the executable.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*"
           Name="WindowCraft"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="WindowCraft Dev Team"
           UpgradeCode="7D3C2E61-4A0B-4F5E-9C21-6B1E8A4F0D37">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="$(var.Platform)"
             Description="WindowCraft $(var.Version)"
             Comments="Windows 11 administration, debloating and ISO mastering" />

    <!-- A pre-release and the stable build of one version share it, so the
         stable one has to replace the pre-release instead of installing beside it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of WindowCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WindowCraft.ico" SourceFile="$(var.Assets)\windowcraft.ico" />
    <Property Id="ARPPRODUCTICON" Value="WindowCraft.ico" />
    <Property Id="ARPHELPLINK" Value="$(var.ProjectUrl)" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.ProjectUrl)" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!-- Set by setup.exe: the launch checkbox, its UI level (4 is the full UI)
         and the registry key of its own Programs and Features entry. -->
    <Property Id="WCLAUNCH" Secure="yes" />
    <Property Id="WCUILEVEL" Secure="yes" />
    <Property Id="WCBUNDLEKEY" Secure="yes" />

    <!-- WCLANGUAGE=pl (or en, de, fr, es, it, pt-BR, uk) presets the language
         WindowCraft starts in for every user. A later install without the
         property keeps the earlier choice. Without it the app follows the
         Windows display language. -->
    <Property Id="WCLANGUAGE" Secure="yes" />
    <Property Id="WCLANGUAGE_SAVED" Secure="yes">
      <RegistrySearch Id="SavedLanguageSearch" Root="HKLM" Key="SOFTWARE\WindowCraft"
                      Name="Language" Type="raw" Win64="$(var.Win64)" />
    </Property>
    <SetProperty Id="WCLANGUAGE" Value="[WCLANGUAGE_SAVED]" After="AppSearch" Sequence="both">
      NOT WCLANGUAGE AND WCLANGUAGE_SAVED
    </SetProperty>

    <!-- msiexec sees a capped VersionNT on Windows 10 and later, so the real
         build number has to come from the registry. -->
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Win64="yes" />
    </Property>
    <Condition Message="WindowCraft requires Windows 11 or later.">
      <![CDATA[Installed OR WINDOWSBUILD >= 22000]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.ProgramFilesFolder)">
        <Directory Id="INSTALLFOLDER" Name="WindowCraft" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <ComponentGroup Id="Application" Directory="INSTALLFOLDER">
      <Component Id="Executable" Guid="B6A1F0D4-0C52-4E93-8F3A-2D7C15E9A401" Win64="$(var.Win64)">
        <File Id="WindowCraftExe" Source="$(var.Binary)" Name="windowcraft.exe" KeyPath="yes">
          <!-- Not advertised. An advertised shortcut belongs to this MSI, which
               setup.exe hides from Installed apps, so Start offered no way to
               uninstall. A plain shortcut is matched by its folder instead. -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="WindowCraft"
                    Description="Windows 11 administration, debloating and ISO mastering"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="no" />
        </File>
      </Component>
      <Component Id="ConsoleFrontEnd" Guid="F0E514D8-4A96-42D7-CD7E-61B059CDE845" Win64="$(var.Win64)">
        <File Id="WindowCraftCli" Source="$(var.CliBinary)" Name="windowcraft-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="License" Guid="C7B2E1A5-1D63-4FA4-9A4B-3E8D26FAB512" Win64="$(var.Win64)">
        <File Id="LicenseFile" Source="$(var.Root)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="Notice" Guid="D8C3F2B6-2E74-40B5-AB5C-4F9E37ABC623" Win64="$(var.Win64)">
        <File Id="NoticeFile" Source="$(var.Root)\NOTICE.md" Name="NOTICE.md" KeyPath="yes" />
      </Component>
      <Component Id="ThirdParty" Guid="0A1F6B2C-5D07-43E8-DE8F-72C16ADEF956" Win64="$(var.Win64)">
        <File Id="ThirdPartyNotices" Source="$(var.Root)\THIRD-PARTY-NOTICES.md" Name="THIRD-PARTY-NOTICES.md" KeyPath="yes" />
      </Component>
      <Component Id="CommandLine" Guid="E9D403C7-3F85-41C6-BC6D-50AF48BCD734" Win64="$(var.Win64)">
        <CreateFolder />
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <Component Id="LanguageConfig" Guid="D2A684C2-4B6E-4E65-B5E3-72E6F255CA21" Win64="$(var.Win64)">
        <Condition>
          <![CDATA[WCLANGUAGE = "en" OR WCLANGUAGE = "pl" OR WCLANGUAGE = "de" OR WCLANGUAGE = "fr" OR WCLANGUAGE = "es" OR WCLANGUAGE = "it" OR WCLANGUAGE = "pt-BR" OR WCLANGUAGE = "uk"]]>
        </Condition>
        <RegistryKey Root="HKLM" Key="SOFTWARE\WindowCraft">
          <RegistryValue Name="Language" Value="[WCLANGUAGE]" Type="string" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Registry only, in the 32-bit view where Burn keeps its entry. -->
    <DirectoryRef Id="TARGETDIR">
      <!-- Burn writes no InstallLocation into the setup.exe entry; this adds it,
           so Windows can tie the Start shortcut to the visible entry. Burn
           deletes the whole key when the bundle goes. -->
      <Component Id="BundleInstallLocation" Guid="5C1E7A90-3B2D-4F6A-8E15-9D4C27B6A3F1" Win64="no">
        <Condition>WCBUNDLEKEY</Condition>
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\[WCBUNDLEKEY]"
                       Name="InstallLocation" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="WindowCraft" Level="1">
      <ComponentGroupRef Id="Application" />
      <ComponentRef Id="BundleInstallLocation" />
    </Feature>

    <!-- Uninstall leaves nothing behind. It runs as SYSTEM to reach every profile,
         and an upgrade skips it so Time Machine history survives. -->
    <SetProperty Id="PurgeUserData" Value="&quot;[INSTALLFOLDER]windowcraft.exe&quot; --purge-data"
                 Before="PurgeUserData" Sequence="execute" />
    <CustomAction Id="PurgeUserData" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- An open WindowCraft window holds its exe and Time Machine database, and
         a window in the user's session cannot be asked to close from the
         installer service. So removing this version, alone or as part of an
         upgrade, first ends every process started from INSTALLFOLDER, as
         SYSTEM, and waits for it to exit. -->
    <SetProperty Id="CloseRunningApp" Value="&quot;[INSTALLFOLDER]windowcraft.exe&quot; --close-running"
                 Before="CloseRunningApp" Sequence="execute" />
    <CustomAction Id="CloseRunningApp" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- The launch checkbox of setup.exe. msiexec runs this elevated, and
         explorer.exe hands the path to the running shell, so the app starts
         as the signed-in user without elevation. -->
    <CustomAction Id="LaunchAfterSetup" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER]windowcraft.exe&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="CloseRunningApp" Before="PurgeUserData">REMOVE="ALL"</Custom>
      <Custom Action="PurgeUserData" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="LaunchAfterSetup" After="InstallFinalize">WCLAUNCH = "1" AND WCUILEVEL = "4" AND NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <UI>
      <UIRef Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Assets)\wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Assets)\wix-dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch WindowCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#WindowCraftExe]" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />
  </Product>
</Wix>
