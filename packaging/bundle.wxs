<?xml version="1.0" encoding="UTF-8"?>
<!-- Made by ycangignacy -->
<!-- setup.exe: a single download that carries the MSI and shows a simple UI. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">
  <Bundle Name="WindowCraft"
          Version="$(var.Version)"
          Manufacturer="ycangignacy"
          UpgradeCode="1F4E9B72-5A1C-4D86-B3E7-8C2F60D1E948"
          IconSourceFile="$(var.Assets)\windowcraft.ico"
          AboutUrl="$(var.ProjectUrl)"
          DisableModify="yes">
    <!-- Burn otherwise leaves a log in %TEMP% on every run. -->
    <Log Disable="yes" />
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtfLicense">
      <bal:WixStandardBootstrapperApplication LicenseFile="$(var.LicenseRtf)"
                                              LogoFile="$(var.Assets)\logo-64.png"
                                              SuppressOptionsUI="yes"
                                              SuppressRepair="yes" />
    </BootstrapperApplicationRef>
    <bal:Condition Message="WindowCraft requires Windows 11 or later.">WindowsBuildNumber &gt;= 22000</bal:Condition>
    <Chain>
      <MsiPackage SourceFile="$(var.Msi)" DisplayInternalUI="no" Vital="yes" Compressed="yes" />
    </Chain>
  </Bundle>
</Wix>
