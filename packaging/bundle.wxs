<?xml version="1.0" encoding="UTF-8"?>
<!-- Made by Nordan -->
<!-- setup.exe: a single download that carries the MSI and shows a simple UI. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">
  <Bundle Name="WindowCraft"
          Version="$(var.Version)"
          Manufacturer="Nordan"
          UpgradeCode="1F4E9B72-5A1C-4D86-B3E7-8C2F60D1E948"
          IconSourceFile="$(var.Assets)\windowcraft.ico"
          AboutUrl="$(var.ProjectUrl)"
          DisableModify="yes">
    <!-- Burn otherwise leaves a log in %TEMP% on every run. -->
    <Log Disable="yes" />
    <!-- UseUILanguages: pick the theme language from the Windows display language.
         Without it WixStdBA goes by the regional format, so a Polish Windows with
         US formats got the English pages. -->
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtfLicense" bal:UseUILanguages="yes">
      <!-- theme.xml is the stock RtfTheme plus a "launch when done" checkbox. -->
      <bal:WixStandardBootstrapperApplication LicenseFile="$(var.LicenseRtf)"
                                              LogoFile="$(var.Assets)\logo-64.png"
                                              ThemeFile="$(var.Root)\packaging\theme.xml"
                                              LocalizationFile="$(var.Root)\packaging\lang\1033\thm.wxl"
                                              SuppressOptionsUI="yes"
                                              SuppressRepair="yes" />
      <!-- The setup UI follows the Windows display language. -->
      <Payload Id="thm_1033" SourceFile="$(var.Root)\packaging\lang\1033\thm.wxl" Name="1033\thm.wxl" />
      <Payload Id="thm_1045" SourceFile="$(var.Root)\packaging\lang\1045\thm.wxl" Name="1045\thm.wxl" />
      <Payload Id="thm_1031" SourceFile="$(var.Root)\packaging\lang\1031\thm.wxl" Name="1031\thm.wxl" />
      <Payload Id="thm_1036" SourceFile="$(var.Root)\packaging\lang\1036\thm.wxl" Name="1036\thm.wxl" />
      <Payload Id="thm_3082" SourceFile="$(var.Root)\packaging\lang\3082\thm.wxl" Name="3082\thm.wxl" />
      <Payload Id="thm_1040" SourceFile="$(var.Root)\packaging\lang\1040\thm.wxl" Name="1040\thm.wxl" />
      <Payload Id="thm_1046" SourceFile="$(var.Root)\packaging\lang\1046\thm.wxl" Name="1046\thm.wxl" />
      <Payload Id="thm_1058" SourceFile="$(var.Root)\packaging\lang\1058\thm.wxl" Name="1058\thm.wxl" />
    </BootstrapperApplicationRef>
    <!-- setup.exe WCLANGUAGE=pl passes the language on to the MSI. -->
    <Variable Name="WCLANGUAGE" Value="" bal:Overridable="yes" />
    <!-- The checkbox of the same name on the Install page starts checked.
         The MSI starts the app only after a full-UI install, never with /quiet
         or /passive. setup.exe LaunchWindowCraft=0 turns it off. -->
    <Variable Name="LaunchWindowCraft" Type="numeric" Value="1" bal:Overridable="yes" />
    <!-- WixStdBA fills #(loc.*) in condition messages from the thm.wxl of the
         language it runs in, the same as the theme text. -->
    <bal:Condition Message="#(loc.ConditionWindows11)">WindowsBuildNumber &gt;= 22000</bal:Condition>
    <Chain>
      <MsiPackage SourceFile="$(var.Msi)" DisplayInternalUI="no" Vital="yes" Compressed="yes">
        <MsiProperty Name="WCLANGUAGE" Value="[WCLANGUAGE]" />
        <MsiProperty Name="WCLAUNCH" Value="[LaunchWindowCraft]" />
        <MsiProperty Name="WCUILEVEL" Value="[WixBundleUILevel]" />
        <MsiProperty Name="WCBUNDLEKEY" Value="[WixBundleProviderKey]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
