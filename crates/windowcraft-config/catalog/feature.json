    "features": [
      "VirtualMachinePlatform",
      "Microsoft-Windows-Subsystem-Linux"
    ]
  },
  {
    "id": "nfs",
    "legacy_id": "WPFFeaturenfs",
    "name": "Network File System (NFS) - Enable",
    "description": "Network File System (NFS) is a mechanism for storing files on a network.",
    "kind": "feature",
    "features": [
      "ServicesForNFS-ClientOnly",
      "ClientForNFS-Infrastructure",
      "NFS-Administration"
    ],
    "registry": [
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\ClientForNFS\\CurrentVersion\\Default",
        "name": "AnonymousUID",
        "kind": "DWord",
        "value": "0",
        "original": "<RemoveEntry>"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\ClientForNFS\\CurrentVersion\\Default",
        "name": "AnonymousGID",
        "kind": "DWord",
        "value": "0",
        "original": "<RemoveEntry>"
      }
    ],
    "apply": [
      {
        "op": "nfs_configure"
      }
    ]
  },
  {
    "id": "reg-backup",
    "legacy_id": "WPFFeatureRegBackup",
    "name": "Registry Backup (Daily Task 12:30am) - Enable",
    "description": "Enables daily registry backup, previously disabled by Microsoft in Windows 10 1803.",
    "kind": "feature",
    "registry": [
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Configuration Manager",
        "name": "EnablePeriodicBackup",
        "kind": "DWord",
        "value": "1",
        "original": "<RemoveEntry>"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Configuration Manager",
        "name": "BackupCount",
        "kind": "DWord",
        "value": "2",
        "original": "<RemoveEntry>"
      }
    ],
    "apply": [
      {
        "op": "create_registry_backup_task"
      }
    ],
    "undo": [
      {
        "op": "remove_registry_backup_task"
      }
    ]
  },
